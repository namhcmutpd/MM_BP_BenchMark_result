@startuml UC02_DangNhap
title Activity Diagram - UC02: Đăng nhập hệ thống

|Người dùng|
start
:Mở ứng dụng;
:Nhập email và mật khẩu;
:Nhấn nút "Đăng nhập";

|Hệ thống|
:Kiểm tra định dạng email và\nđộ dài mật khẩu;
if (Định dạng hợp lệ?) then (Không)
  :Hiển thị lỗi định dạng;
  |Người dùng|
  :Chỉnh sửa thông tin;
  |Hệ thống|
else (Có)
endif

:Tìm kiếm tài khoản theo email;
if (Tài khoản tồn tại?) then (Không)
  :Hiển thị thông báo\n"Email không tồn tại";
  |Người dùng|
  :Kiểm tra lại email;
  |Hệ thống|
else (Có)
endif

:Xác minh mật khẩu (so sánh hash);
if (Mật khẩu đúng?) then (Không)
  :Tăng bộ đếm đăng nhập thất bại;
  if (Vượt quá 5 lần thất bại?) then (Có)
    :Khoá tài khoản tạm thời (15 phút);
    :Hiển thị thông báo khoá tài khoản;
  else (Không)
    :Hiển thị thông báo\n"Sai mật khẩu";
  endif
  |Người dùng|
  :Thử lại;
  |Hệ thống|
else (Có)
endif

:Tạo phiên đăng nhập (session/token);
:Chuyển đến màn hình trang chủ;
:Hiển thị Dashboard sức khỏe;

stop
@enduml
