@startuml UC01_DangKyTaiKhoan
title Activity Diagram - UC01: Đăng ký tài khoản

|Người dùng|
start
:Mở ứng dụng;
:Chọn "Đăng ký";
:Nhập họ tên, email, mật khẩu\nvà thông tin cơ bản (tuổi, giới tính, chiều cao, cân nặng);

|Hệ thống|
:Kiểm tra định dạng dữ liệu đầu vào;
if (Dữ liệu hợp lệ?) then (Không)
  :Hiển thị thông báo lỗi\n(trường còn thiếu / sai định dạng);
  |Người dùng|
  :Sửa lại thông tin;
  |Hệ thống|
else (Có)
endif

:Kiểm tra email đã tồn tại chưa;
if (Email đã đăng ký?) then (Có)
  :Hiển thị thông báo\n"Email đã được sử dụng";
  |Người dùng|
  :Nhập email khác;
  |Hệ thống|
else (Không)
endif

:Tạo tài khoản mới trong CSDL;
:Gửi email xác thực đến địa chỉ đã nhập;

|Người dùng|
:Mở email và nhấn liên kết xác thực;

|Hệ thống|
:Xác minh token trong liên kết;
if (Token hợp lệ?) then (Không)
  :Hiển thị thông báo "Liên kết hết hạn\nhoặc không hợp lệ";
  :Cho phép gửi lại email xác thực;
else (Có)
  :Kích hoạt tài khoản;
  :Chuyển hướng về màn hình đăng nhập;
  :Hiển thị thông báo\n"Đăng ký thành công!";
endif

stop
@enduml
